{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/analysis/get",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$[?(@.analysisId == 'analysis_99999')]"
        }
      }
    ]
  },
  "response": {
    "status": 404,
    "jsonBody": {
      "responseType": "error",
      "result": "error",
      "errors": [
        {
          "code": "ANALYSIS_NOT_FOUND",
          "message": "Анализ не найден"
        }
      ],
      "timestamp": "{{now}}"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"]
  }
}