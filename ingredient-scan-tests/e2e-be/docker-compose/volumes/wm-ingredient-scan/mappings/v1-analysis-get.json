{
  "request": {
    "method": "POST",
    "url": "/v1/analysis/get",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.analysisId",
        "equalTo": "analysis_123"
      },
      {
        "matchesJsonPath": "$.requestType",
        "equalTo": "analysisGet"
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "responseType": "analysisGet",
      "result": "success",
      "analysis": {
        "id": "{{{jsonPath request.body '$.analysisId'}}}",
        "createDate": "{{now}}",
        "compositionId": "composition_123",
        "rating": 3.2,
        "color": "LIGHT_YELLOW",
        "problematicComponent": [],
        "safeComponent": [],
        "description": "Анализ выполнен"
      }
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"]
  }
}